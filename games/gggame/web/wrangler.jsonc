{
  "name": "gggame-rooms",
  "main": "gggame/worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "gggame-api.yuanyiyan.com",
      "custom_domain": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "GameRoom"
      },
      {
        "name": "LEADERBOARD",
        "class_name": "Leaderboard"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GameRoom"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "Leaderboard"
      ]
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://www.yuanyiyan.com,https://yuanyiyan.com"
  },
  "env": {
    "local": {
      "name": "gggame-rooms-local",
      "durable_objects": {
        "bindings": [
          {
            "name": "ROOMS",
            "class_name": "GameRoom"
          },
          {
            "name": "LEADERBOARD",
            "class_name": "Leaderboard"
          }
        ]
      },
      "vars": {
        "ALLOWED_ORIGINS": "http://localhost:4321,http://127.0.0.1:4321"
      }
    }
  }
}
