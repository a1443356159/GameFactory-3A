{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Camera View 1.0",
  "description": "One fixed camera per video. Right-handed world space, Y up, angles in degrees, distances in scene units.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "coordinate_system", "projection", "pose"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "coordinate_system": {"const": "Y_UP_RIGHT_HANDED"},
    "projection": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "fov_y_deg", "near", "far"],
          "properties": {
            "type": {"const": "perspective"},
            "fov_y_deg": {"type": "number", "minimum": 10, "maximum": 100},
            "near": {"type": "number", "exclusiveMinimum": 0},
            "far": {"type": "number", "exclusiveMinimum": 0}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "vertical_size", "near", "far"],
          "properties": {
            "type": {"const": "orthographic"},
            "vertical_size": {"type": "number", "exclusiveMinimum": 0},
            "near": {"type": "number", "minimum": 0},
            "far": {"type": "number", "exclusiveMinimum": 0}
          }
        }
      ]
    },
    "pose": {
      "type": "object", "additionalProperties": false,
      "required": ["target", "azimuth_deg", "elevation_deg", "distance"],
      "properties": {
        "target": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
        "azimuth_deg": {"type": "number", "minimum": -180, "maximum": 180},
        "elevation_deg": {"type": "number", "minimum": -85, "maximum": 85},
        "distance": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "framing": {
      "type": "object", "additionalProperties": false,
      "required": ["required_targets", "safe_margin"],
      "properties": {
        "required_targets": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "safe_margin": {"type": "number", "minimum": 0, "maximum": 0.4}
      }
    }
  }
}
