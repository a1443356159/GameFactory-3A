{
  "name": "gggame-rooms",
  "main": "gggame/worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "routes": [{ "pattern": "gggame-api.yuanyiyan.com", "custom_domain": true }],
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "GameRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],
  "vars": { "ALLOWED_ORIGINS": "https://www.yuanyiyan.com,https://yuanyiyan.com" },
  "env": {
    "local": {
      "name": "gggame-rooms-local",
      "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "GameRoom" }] },
      "vars": { "ALLOWED_ORIGINS": "http://localhost:4321,http://127.0.0.1:4321" }
    }
  }
}
